    <diagram id="arch" name="1. Architecture">
        <mxGraphModel dx="331" dy="434" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="fe" value="&lt;font color=&quot;#301c1c&quot;&gt;&lt;b&gt;Frontend: Next.js&lt;/b&gt;&lt;br&gt;&lt;br&gt;User switcher (mock login)&lt;br&gt;Employee: my claims, claim form, history&lt;br&gt;Approver: review queue, reviewed list,&lt;br&gt;approve / partial / reject / pay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="260" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="be" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;Backend: FastAPI&lt;/b&gt;&lt;br&gt;&lt;br&gt;routers/claims.py: HTTP only&lt;br&gt;services.py: business rules, transitions&lt;br&gt;state_machine.py: (status, action) lookup table&lt;br&gt;auth.py: X-User-Id header → user + role&lt;br&gt;schemas.py: Pydantic validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="400" y="60" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="db" value="&lt;font color=&quot;#1a1a1a&quot;&gt;&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;users&lt;br&gt;claims&lt;br&gt;claim_events&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="800" y="90" width="170" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="tests" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;pytest + TestClient&lt;/b&gt;&lt;br&gt;fresh temp SQLite per test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="400" y="310" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="REST + JSON&lt;br&gt;X-User-Id header" style="endArrow=classic;startArrow=classic;html=1;rounded=0;" parent="1" source="fe" target="be" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
